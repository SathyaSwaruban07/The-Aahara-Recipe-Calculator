# Neon Postgres — REQUIRED for the API (local .env or host secret — NEVER commit)
# GitHub → Settings → Secrets: use DATABASE_URL on your API host (Render/Railway/Fly),
# not in the browser. The client never sees this value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

PORT=4000
# Your GitHub Pages URL or local Vite origin (CORS)
CLIENT_ORIGIN=http://localhost:5173

LIBRETRANSLATE_URL=https://libretranslate.com
# LIBRETRANSLATE_API_KEY=
