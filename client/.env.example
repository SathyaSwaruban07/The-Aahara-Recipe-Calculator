# Only needed when UI is hosted separately from the API (e.g. GitHub Pages).
# Set this in GitHub Actions as a repository secret named VITE_API_URL, e.g.:
#   https://your-api.onrender.com/api
#
# Do NOT put DATABASE_URL here — that stays on the server only.
# VITE_API_URL=https://your-api.example.com/api
#
# VITE_ADMIN_USER=admin
# VITE_ADMIN_PASS=change-me
